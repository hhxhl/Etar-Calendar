<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grid_widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_surface" android:tint="@color/widget_live_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Shared grid date title -->
    <LinearLayout
        android:id="@+id/grid_widget_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dip"
        android:paddingEnd="4dip">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grid_widget_title"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/grid_widget_lunar_title"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/grid_widget_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:contentDescription="@string/widget_menu_more_options"
            android:src="@drawable/ic_widget_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/grid_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <!-- Day-of-week labels row -->
    <LinearLayout
        android:id="@+id/grid_dow_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dip"
        android:paddingBottom="4dip"
        android:paddingStart="@dimen/item_widget_content_inset"
        android:paddingEnd="@dimen/item_widget_content_inset">

        <TextView
            android:id="@+id/grid_dow_0"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/grid_dow_1"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/grid_dow_2"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/grid_dow_3"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/grid_dow_4"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/grid_dow_5"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/grid_dow_6"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Grid of day cells -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="@dimen/item_widget_content_inset"
            android:paddingEnd="@dimen/item_widget_content_inset"
            android:paddingBottom="4dp"
            android:clipToPadding="true"
            android:numColumns="7"
            android:scrollbars="none"
            android:stretchMode="columnWidth" />

    </RelativeLayout>
</LinearLayout>
</FrameLayout>
